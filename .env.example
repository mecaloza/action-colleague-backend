# Copy to .env for local development. Never commit real values.

# Postgres (Supabase). Local development can use SQLite: sqlite:///./local.db
DATABASE_URL=sqlite:///./local.db

# JWT signing secret — required in production (min 32 chars). SECRET_KEY is accepted too.
JWT_SECRET=

# Comma-separated browser origins allowed by CORS, and an optional regex (e.g. Vercel previews)
CORS_ORIGINS=http://localhost:3001
CORS_ORIGIN_REGEX=

# Supabase Storage (service/secret key — backend only). Without it, development stores media in LOCAL_STORAGE_DIR.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
MEDIA_BUCKET=course-media
LOCAL_STORAGE_DIR=./.storage
PUBLIC_API_URL=http://localhost:8001/api/v1

# Background jobs inside the API process
WORKER_ENABLED=true
WORKER_CONCURRENCY=2

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Local development without API keys: deterministic fake AI, voice and presenter
USE_FAKE_PROVIDERS=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWnGpdt
ELEVENLABS_MODEL=eleven_multilingual_v2
HEYGEN_API_KEY=
HEYGEN_ENGINE=avatar_iii
